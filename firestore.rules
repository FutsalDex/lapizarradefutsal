
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =============================
    // 🔒 UTILIDADES
    // =============================
    function isAuth() {
      return request.auth != null;
    }

    function authEmail() {
      return isAuth() ? request.auth.token.email : null;
    }

    // 👑 Admin global
    function isAdmin() {
      return isAuth() && authEmail() == 'futsaldex@gmail.com';
    }

    function isTeamOwner(teamId) {
      // Ensure the user is authenticated and the team document exists before checking ownerId
      return isAuth() &&
        exists(/databases/$(database)/documents/teams/$(teamId)) &&
        get(/databases/$(database)/documents/teams/$(teamId)).data.ownerId == request.auth.uid;
    }
    
    // Miembro de un equipo (o dueño)
    function isTeamMember(teamId) {
      if (!isAuth()) {
        return false;
      }
      if (!exists(/databases/$(database)/documents/teams/$(teamId))) {
        return false;
      }
      
      let teamData = get(/databases/$(database)/documents/teams/$(teamId)).data;
      
      if (teamData.ownerId == request.auth.uid) {
        return true;
      }
      
      if ('memberIds' in teamData && teamData.memberIds is list) {
        return request.auth.uid in teamData.memberIds;
      }
      
      return false;
    }

    // =============================
    // 👤 USERS
    // =============================
    match /users/{userId} {
      allow get: if isAuth(); // Any authenticated user can read user profiles to check roles, etc.
      allow create: if isAuth() && request.resource.data.uid == request.auth.uid;
      allow update: if (request.auth != null && request.auth.uid == userId) || isAdmin();
      allow list: if isAdmin(); // Only admins can list all users

      // Subcolecciones de usuario
      match /favorites/{favoriteId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /sessions/{sessionId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // =============================
    // 🏋️ EXERCISES
    // =============================
    match /exercises/{exerciseId} {
      // ANYONE can read exercises.
      allow get, list: if true;
      
      // Only admins or the user who created it can modify exercises.
      allow create: if isAuth() && (isAdmin() || request.resource.data.userId == request.auth.uid);
      allow update, delete: if isAuth() && (isAdmin() || resource.data.userId == request.auth.uid);
    }

    // =============================
    // 📖 USER EXERCISES (personales)
    // =============================
    match /userExercises/{exerciseId} {
      allow read, write: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
    }

    // =============================
    // 🏟️ TEAMS
    // =============================
    match /teams/{teamId} {
      allow get: if isTeamMember(teamId) || isAdmin();
      allow list: if isAuth();
      allow create: if isAuth() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isTeamOwner(teamId) || isAdmin();

      match /players/{playerId} {
        allow read, write: if isTeamMember(teamId) || isAdmin();
      }
      match /staff/{staffId} {
        allow read, write: if isTeamOwner(teamId) || isAdmin();
      }
      match /attendance/{attendanceId} {
        allow read, write: if isTeamMember(teamId) || isAdmin();
      }
    }

    // =============================
    // ⚽ MATCHES (PARTIDOS)
    // =============================
    match /matches/{matchId} {
      // Allow read/update/delete if the user is a member of the team associated with the match.
      allow read, update, delete: if isTeamMember(resource.data.teamId) || isAdmin();
      // Allow create if the user is a member of the team they are creating the match for.
      allow create: if isTeamMember(request.resource.data.teamId) || isAdmin();
      // Allow list operations for any authenticated user. Queries should be secured client-side.
      allow list: if isAuth() || isAdmin();
    }

    // =============================
    // 💌 INVITATIONS
    // =============================
    match /invitations/{invitationId} {
      allow read, list: if isAdmin() || (isAuth() && request.auth.uid == resource.data.inviterId);
      allow create: if isAuth() && request.resource.data.inviterId == request.auth.uid;
      allow update, delete: if isAdmin();
    }
    
    // ============================================================
    // ❌ Colecciones obsoletas (bloqueadas)
    // ============================================================
    match /teamMembers/{memberId} { allow read, write: if false; }
    match /referrals/{referralId} { allow read, write: if false; }
  }
}
