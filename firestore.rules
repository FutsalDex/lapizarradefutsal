
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =============================
    // 🔒 UTILIDADES
    // =============================
    function isAuth() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    function authEmail() {
      return isAuth() ? request.auth.token.email : null;
    }

    // 👑 Admin global
    function isAdmin() {
      return isAuth() && authEmail() == 'futsaldex@gmail.com';
    }

    // 🧑‍💼 Propietario del equipo
    function isTeamOwner(teamId) {
      return isAuth() &&
        exists(/databases/$(database)/documents/teams/$(teamId)) &&
        get(/databases/$(database)/documents/teams/$(teamId)).data.ownerId == request.auth.uid;
    }

    // Miembro de un equipo (o dueño)
    function isTeamMember(teamId) {
      return isAuth() &&
             exists(/databases/$(database)/documents/teams/$(teamId)) &&
             (
               request.auth.uid in get(/databases/$(database)/documents/teams/$(teamId)).data.memberIds ||
               isTeamOwner(teamId)
             );
    }

    // =============================
    // 👤 USERS
    // =============================
    match /users/{userId} {
      allow get: if isAuth(); // Any authenticated user can read user profiles to check roles, etc.
      allow create: if isAuth() && request.resource.data.uid == request.auth.uid;
      allow update: if isOwner(userId) || isAdmin();
      allow list, delete: if isAdmin(); // Only admins can list all users

      // Subcolecciones de usuario
      match /favorites/{favoriteId} {
        // A user can only read and write their own favorites.
        allow get, list, write, delete: if isOwner(userId);
      }
      match /sessions/{sessionId} {
        allow get, list, write, delete: if isOwner(userId);
      }
    }

    // =============================
    // 🏋️ EXERCISES
    // =============================
    match /exercises/{exerciseId} {
      // ANYONE can read exercises.
      allow get, list: if true;
      
      // Only admins or the user who created it can modify exercises.
      allow create: if isAuth() && (isAdmin() || request.resource.data.userId == request.auth.uid);
      allow update, delete: if isAuth() && (isAdmin() || resource.data.userId == request.auth.uid);
    }

    // =============================
    // 📖 USER EXERCISES (personales)
    // =============================
    match /userExercises/{exerciseId} {
      allow read, write: if isAuth() && resource.data.userId == request.auth.uid;
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
    }

    // =============================
    // 🏟️ TEAMS
    // =============================
    match /teams/{teamId} {
      allow get, list: if isTeamMember(teamId) || isAdmin();
      allow create: if isAuth() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isTeamOwner(teamId) || isAdmin();

      match /players/{playerId} {
        allow read, write: if isTeamMember(teamId) || isAdmin();
      }
      match /staff/{staffId} {
        allow read, write: if isTeamOwner(teamId) || isAdmin();
      }
      match /attendance/{attendanceId} {
        allow read, write: if isTeamMember(teamId) || isAdmin();
      }
    }

    // =============================
    // ⚽ MATCHES (PARTIDOS)
    // =============================
    match /matches/{matchId} {
      function isMatchOwnerOrMember() {
          return isAuth() && exists(/databases/$(database)/documents/teams/$(resource.data.teamId)) && isTeamMember(resource.data.teamId);
      }
      allow read, list, create, update, delete: if isMatchOwnerOrMember() || isAdmin();
    }

    // =============================
    // 💌 INVITATIONS
    // =============================
    match /invitations/{invitationId} {
      allow read, list: if isAdmin() || (isAuth() && request.auth.uid == resource.data.inviterId);
      allow create: if isAuth() && request.resource.data.inviterId == request.auth.uid;
      allow update, delete: if isAdmin();
    }
    
    // ============================================================
    // ❌ Colecciones obsoletas (bloqueadas)
    // ============================================================
    match /teamMembers/{memberId} { allow read, write: if false; }
    match /referrals/{referralId} { allow read, write: if false; }
  }
}
